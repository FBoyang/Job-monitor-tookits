# ┌──────────────────────────────────────────────────────────────┐
# │  DO NOT put real keys in this file or any file in this repo  │
# │  Set these in your ~/.bashrc or ~/.bash_profile instead      │
# └──────────────────────────────────────────────────────────────┘

# ── HMS Azure OpenAI (recommended) ──────────────────────────────
# export AZURE_OPENAI_API_KEY="your-32-character-key-here"
# export AZURE_OPENAI_ENDPOINT="https://azure-ai.hms.edu"      # production
# export AZURE_OPENAI_DEPLOYMENT="gpt-5"                        # or gpt-5-mini
# export AZURE_OPENAI_API_VERSION="2025-03-01-preview"          # optional

# ── Direct OpenAI (alternative) ─────────────────────────────────
# export OPENAI_API_KEY="sk-..."
